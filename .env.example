# --- Postgres / Supabase ---
# Two DIFFERENT connection strings on purpose — see 06_configuration_deployment.md §2 for why.
# Use the SESSION pooler (port 5432) or a direct connection for prepared statement support.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
LANGGRAPH_CHECKPOINT_DB_URI=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Pinecone ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_HOST=https://fms-policy-docs-your-id.svc.aped-4627-b74a.pinecone.io

# --- Embeddings + LLM ---
LLM_API_KEY=your-openai-or-gemini-api-key
EMBEDDING_MODEL=text-embedding-3-small

# --- Gmail ---
GMAIL_SERVICE_ACCOUNT_JSON=./secrets/gmail-service-account.json
GMAIL_SENDER_ADDRESS=bookings@yourdomain.com
GMAIL_DELEGATED_SUBJECT=bookings@yourdomain.com

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_your_stripe_webhook_secret

# --- Worker / Scheduler ---
WORKER_URL=http://worker:8001
API_URL=http://api:8000
